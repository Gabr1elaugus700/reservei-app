# Copie para .env e troque os placeholders. Não commite o .env.
# cp .env.example .env

# Postgres. O host na DATABASE_URL é o nome do serviço, "postgres", não localhost.
# Usuário, senha e banco precisam ser os mesmos nos dois lugares.
# Se a senha tiver @ : / # ou espaço, codifique esses caracteres na DATABASE_URL.
POSTGRES_USER=reservei
POSTGRES_PASSWORD=troque-por-uma-senha-longa
POSTGRES_DB=reservei
DATABASE_URL=postgresql://reservei:troque-por-uma-senha-longa@postgres:5432/reservei

# Better Auth. Gere o segredo com: openssl rand -base64 32
# BETTER_AUTH_URL é a origem pública usada no login (sem barra no final).
BETTER_AUTH_SECRET=troque-por-openssl-rand-base64-32
BETTER_AUTH_URL=http://localhost:3005

# Variáveis públicas do Next. Entram no build da imagem.
# Depois de mudá-las, suba de novo com: docker compose up -d --build
# NEXT_PUBLIC_APP_URL deve ser a mesma origem de BETTER_AUTH_URL.
# Os subdomínios só redirecionam quando o Host da requisição bate com eles.
# No acesso direto por IP:3005 a página pública abre na raiz.
NEXT_PUBLIC_APP_URL=http://localhost:3005
NEXT_PUBLIC_BASE_DOMAIN=seudominio.com.br
NEXT_PUBLIC_ADMIN_SUBDOMAIN=app
NEXT_PUBLIC_PUBLIC_SUBDOMAIN=reservas

# Admin criado pelo seed na subida do container.
# A senha precisa ter de 8 a 128 caracteres.
# Se o admin já existir e a senha daqui for outra, o próximo start atualiza a senha.
# O seed não imprime a senha e não cria um segundo usuário.
SEED_ADMIN_EMAIL=admin@seudominio.com
SEED_ADMIN_PASSWORD=troque-por-uma-senha-de-admin
SEED_ADMIN_NAME=Administrador

# REDIS_URL e RABBITMQ_URL não são necessárias.
# src/lib/redis.ts e src/lib/rabbit.ts existem, mas nenhum código da aplicação
# importa esses clientes. O compose não sobe Redis nem RabbitMQ.
